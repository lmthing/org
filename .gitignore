node_modules/
dist/
*.tsbuildinfo

# Single-file CLI executables (scripts/bundle/build.mjs) — 200 MB artifacts,
# produced by CI and attached to a release, never committed.
libs/cli/dist-bundle/

# Environment — contains API keys, never commit
.env
.env.local
.env.*.local
.env.*backup*

# Trace/debug output
trace.jsonl
*.trace.jsonl

# Live/keyless CLI integration test traces
libs/cli/.live-traces/

# solve() candidate scratch dirs (written by the solver fixture)
work/
fixtures/*/work/

# system-space state stores (memory/todo)
.lmthing/
.antigravitycli
dist-web/
.turbo/
scenarios/repros/*/runs/

# Playwright visual-harness runtime artifacts (baselines under tests/visual/__computed__ and
# __screenshots__ ARE committed; these are transient)
tests/visual/dist/
tests/visual/test-results/
tests/visual/playwright-report/
test-results/
apps/web/.tanstack/
