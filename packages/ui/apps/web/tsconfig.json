{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lmthing/ui": ["../../../../libs/ui/src"],
      "@lmthing/ui/*": ["../../../../libs/ui/src/*"],
      "@lmthing/css/*": ["../../../../libs/css/src/*"],
      "@lmthing/state": ["../../../../libs/state/src"],
      "@lmthing/state/*": ["../../../../libs/state/src/*"],
      "@lmthing/auth": ["../../../../libs/auth/src"],
      "@lmthing/auth/*": ["../../../../libs/auth/src/*"],
      "@lmthing/agent-ui": ["../../src/index.ts"],
      "@lmthing/agent-ui/*": ["../../src/*"]
    },
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
