{
  "extends": "../tsconfig.vite-app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lmthing/ui": ["../../../../libs/ui/src"],
      "@lmthing/ui/*": ["../../../../libs/ui/src/*"],
      "@lmthing/css/*": ["../../../../libs/css/src/*"],
      "@lmthing/state": ["../../../../libs/state/src/index.ts"],
      "@lmthing/state/*": ["../../../../libs/state/src/*"],
      "@lmthing/auth": ["../../../../libs/auth/src"],
      "@lmthing/auth/*": ["../../../../libs/auth/src/*"],
      "@lmthing/agent-ui": ["../../src/index.ts"],
      "@lmthing/agent-ui/*": ["../../src/*"]
    }
  },
  "include": [
    "src",
    "../../../../libs/ui/src",
    "../../../../libs/css/src",
    "../../src"
  ]
}
