{
  "name": "@lmthing/agent-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./app-entry": "./src/app/main.tsx",
    "./compat": "./src/compat/index.ts",
    "./theme": "./src/theme/theme.ts",
    "./web-css": "./dist-web/app.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "tailwindcss -i src/app/styles.css -o dist-web/app.css --minify",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "dev:css": "tailwindcss -i src/app/styles.css -o dist-web/app.css --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lmthing/auth": "workspace:*",
    "@lmthing/core": "workspace:*",
    "marked": "^14.0.0",
    "zustand": "^4.5.7"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*",
    "@tailwindcss/cli": "^4.3.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.1.0"
  }
}
