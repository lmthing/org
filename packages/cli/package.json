{
  "name": "@repl/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "repl": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/web && cp src/web/app.tsx dist/web/app.tsx",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/azure": "^1.3.25",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.24",
    "@repl/core": "workspace:*",
    "@repl/ui": "workspace:*",
    "ai": "^4.3.19",
    "esbuild": "^0.28.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "tsup": "^8.1.0"
  }
}
