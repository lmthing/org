{
  "extends": "@lmthing/config/tsconfig/react-lib",
  "compilerOptions": {
    // Shared `@lmthing/ui`/`@lmthing/auth` source ships with no build step, so every consumer
    // typechecks it inside its OWN program. `strict: false` matches every other consumer of that
    // source (libs/ui's own tsconfig, apps/web, apps/mobile) — this app's own code is written
    // strict-clean regardless, and `libs/ui`'s own `pnpm typecheck` is the gate on the libraries.
    // Diverging here would just re-report their pre-existing findings under a different package's
    // name, which is noise, not a gate.
    "strict": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lmthing/ui": ["../../libs/ui/src"],
      "@lmthing/ui/*": ["../../libs/ui/src/*"],
      "@lmthing/css/*": ["../../libs/css/src/*"],
      "@lmthing/auth": ["../../libs/auth/src"],
      "@lmthing/auth/*": ["../../libs/auth/src/*"]
    }
  },
  // `vite.config.ts` is deliberately out of the program: it imports `@lmthing/utils/vite`, which is
  // a `.mjs` with no declarations, and every other app in this repo leaves it out for that reason.
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "src-tauri", "dist"]
}
