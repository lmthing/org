{
  "name": "@lmthing/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "LMThing mobile app (Expo + React Native). Renders the SHARED @lmthing/ui surfaces on Tamagui — the same source the web app renders, per docs/mobile-native-chat.md.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "bundle:android": "expo export --platform android --output-dir .expo-bundle-android",
    "bundle:ios": "expo export --platform ios --output-dir .expo-bundle-ios",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-barrel-imports.mjs"
  },
  "dependencies": {
    "@lmthing/css": "workspace:*",
    "@lmthing/ui": "workspace:*",
    "@tamagui/core": "2.5.1",
    "expo": "^57.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "^19.2.0",
    "react-native": "0.86.0",
    "react-native-svg": "^15.0.0",
    "react-native-webview": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@types/react": "^19.2.5",
    "typescript": "^5.4.0"
  }
}
