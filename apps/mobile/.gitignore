.expo-bundle-*
.expo/
dist/

# Generated by `expo prebuild` when you build a dev client locally. This app is
# managed-workflow: the native projects are derived from app.config.js + the config
# plugins, never hand-edited, so they are rebuilt rather than tracked.
android/
ios/

# The Google Play service account `eas submit` authenticates with (eas.json points at
# it). A private key that can publish to the store — never in the repo.
play-service-account.json

# The OTA code-signing PRIVATE key. Whoever holds it can push JavaScript into every
# installed copy of the app, so it lives in Ansible Vault and reaches the update
# server as an env var — never here.
#
# `certs/certificate.pem` is deliberately NOT ignored: it is the PUBLIC half, it is
# compiled into the app binary, and the build fails without it.
certs/private-key.pem

# Downloaded EAS build artifacts (an AAB is ~55 MB, an APK ~80 MB). Kept out of the
# repo: the canonical copy is the EAS build record, which also carries the fingerprint
# and versionCode that make a binary identifiable.
build-artifacts/
