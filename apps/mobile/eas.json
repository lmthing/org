{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.18.0",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.18.0",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "node": "24.18.0",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_OTA_APP_ID": "9a2ba224-69e6-4629-a894-4f42eb305a45"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./play-service-account.json"
      }
    }
  }
}
