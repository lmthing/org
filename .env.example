# Copy this to .env and fill in your values.
# .env is gitignored — never commit it directly.
# To persist secrets for Claude Code web sessions, run:
#   ./scripts/encrypt-env.sh
# and commit the resulting .env.encrypted

AZURE_API_KEY=
AZURE_RESOURCE_NAME=

# lmthing.cloud provider (OpenAI-compatible LiteLLM proxy).
# Use lmthingcloud:<modelId> where modelId is one of the enabled models:
#   DeepSeek-V4-Flash, DeepSeek-V4-Pro, Kimi-K2.6, gpt-5.5
# Budget windows are enforced server-side against this key.
LMTHINGCLOUD_API_KEY=
# LMTHINGCLOUD_BASE_URL=https://lmthing.cloud/v1   # optional override (defaults to prod)

# Model aliases
LM_MODEL_M=azure:DeepSeek-V4-Pro
LM_MODEL_L=azure:DeepSeek-V4-Pro
LM_MODEL=M

# Web search (used by system-spaces/web/functions/webSearch)
TAVILY_API_KEY=
