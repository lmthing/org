# Copy this to .env and fill in your values.
# .env is gitignored — never commit it directly.
# To persist secrets for Claude Code web sessions, run:
#   ./scripts/encrypt-env.sh
# and commit the resulting .env.encrypted

AZURE_API_KEY=
AZURE_RESOURCE_NAME=

# Model aliases
LM_MODEL_M=azure:DeepSeek-V4-Flash
LM_MODEL_L=azure:DeepSeek-V4-Pro
LM_MODEL=M

# Web search (used by system-spaces/web/functions/webSearch)
TAVILY_API_KEY=
