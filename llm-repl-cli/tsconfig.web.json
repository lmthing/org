{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@lmthing/thing-ui/*": ["../ui/src/*"],
      "@lmthing/repl": ["../repl/src/index.ts"]
    }
  },
  "include": ["src/web/**/*"],
  "exclude": ["node_modules"]
}
