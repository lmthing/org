{
  "name": "@lmthing/openclaw-compat",
  "version": "0.1.0",
  "description": "Pod-side host foundation for running OpenClaw plugins in lmthing — a structural shim over OpenClawPluginApi that fails loud on anything not yet implemented",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "openclaw",
    "plugins",
    "compat",
    "pod"
  ],
  "author": "LMThing",
  "license": "MIT"
}
