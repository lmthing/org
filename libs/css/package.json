{
  "name": "@lmthing/css",
  "version": "1.0.0",
  "description": "LMThing shared CSS - design tokens and element styles",
  "type": "module",
  "exports": {
    "./theme": "./src/theme.css",
    "./elements/*": "./src/elements/*",
    "./components/*": "./src/components/*"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "*"
  },
  "author": "LMThing",
  "license": "MIT"
}
