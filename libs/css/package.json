{
  "name": "@lmthing/css",
  "version": "1.0.0",
  "description": "LMThing shared CSS - design tokens and element styles",
  "type": "module",
  "exports": {
    "./theme": "./src/theme.css",
    "./theme.css": "./src/theme.css",
    "./tailwind-theme": "./src/tailwind-theme.css",
    "./tailwind-theme.css": "./src/tailwind-theme.css",
    "./animations": "./src/animations.css",
    "./animations.css": "./src/animations.css",
    "./preflight": "./src/preflight.css",
    "./preflight.css": "./src/preflight.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./tamagui-tokens": "./src/tamagui/tokens.generated.ts",
    "./tokens.manifest.json": "./tokens.manifest.json",
    "./elements/*": "./src/elements/*",
    "./components/*": "./src/components/*"
  },
  "bin": {
    "lmthing-lint-tokens": "./scripts/lint-design-tokens.mjs"
  },
  "files": [
    "src",
    "scripts",
    "tokens.manifest.json",
    "COMPONENTS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "generate": "node scripts/sync-fonts.mjs && node scripts/generate-theme.mjs && node scripts/generate-tamagui-config.mjs && node scripts/generate-components-catalog.mjs",
    "prebuild": "node scripts/sync-fonts.mjs && node scripts/generate-theme.mjs && node scripts/generate-tamagui-config.mjs && node scripts/generate-components-catalog.mjs",
    "lint:tokens": "node scripts/lint-design-tokens.mjs src",
    "lint": "eslint . && node scripts/lint-design-tokens.mjs src",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*",
    "eslint": "^9.0.0"
  },
  "author": "LMThing",
  "license": "MIT"
}
