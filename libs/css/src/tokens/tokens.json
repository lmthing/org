{
  "$meta": {
    "name": "lmthing design tokens",
    "description": "Single source of truth for the lmthing design system. Edit this file, then run `pnpm --filter @lmthing/css generate` to regenerate src/theme.css and tokens.manifest.json. Do NOT hand-edit theme.css.",
    "themes": ["light", "dark"],
    "darkSelector": "[data-theme=\"dark\"]",
    "notes": "Warm brand palette: cozy rainbow anchored in warm stone neutrals. No cool grey, no blue. Brand colors are accents, primary is stone. The rainbow (brand + spectrum) is unchanged across light/dark; only neutrals + semantics shift."
  },

  "theme": {
    "radius-sm": "0.125rem",
    "radius-md": "0.375rem",
    "radius": "0.375rem",
    "radius-lg": "0.5rem",
    "radius-xl": "0.75rem",
    "radius-full": "9999px",
    "font-sans": "TypeMates Cera Round Pro Bold, system-ui, sans-serif",
    "font-display": "TypeMates Cera Round Pro Bold, system-ui, sans-serif",
    "font-mono": "ui-monospace, monospace"
  },

  "spectrum": {
    "from": "brand-1",
    "to": "brand-5",
    "steps": 50,
    "group": "spectrum",
    "description": "50-stop interpolated ramp from brand-1 (yellow) through the warm arc to brand-5 (orchid). Used for per-product accents. Identical in light and dark."
  },

  "colors": [
    { "name": "brand-1", "group": "brand", "light": "#f5c815", "dark": "#f5c815", "description": "THING letter 't' — yellow (sunflower)" },
    { "name": "brand-2", "group": "brand", "light": "#f9a94a", "dark": "#f9a94a", "description": "THING letter 'h' — amber" },
    { "name": "brand-3", "group": "brand", "light": "#f38358", "dark": "#f38358", "description": "THING letter 'i' — coral" },
    { "name": "brand-4", "group": "brand", "light": "#ed92a1", "dark": "#ed92a1", "description": "THING letter 'n' — rose" },
    { "name": "brand-5", "group": "brand", "light": "#d59ec8", "dark": "#d59ec8", "description": "THING letter 'g' — orchid" },

    { "name": "neutral-1", "group": "neutral", "light": "#cbcac8", "dark": "#8a8175", "description": "Warm stone neutral (never cool grey)" },
    { "name": "neutral", "group": "neutral", "light": "#cbcac8", "dark": "#8a8175", "description": "Alias of neutral-1" },

    { "name": "background", "group": "surface", "light": "#ffffff", "dark": "#1a1816", "description": "Page background" },
    { "name": "foreground", "group": "surface", "light": "#1c1917", "dark": "#ece8e3", "description": "Default body text" },
    { "name": "card", "group": "surface", "light": "#ffffff", "dark": "#211e1b", "description": "Card / raised surface" },
    { "name": "card-foreground", "group": "surface", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on card" },
    { "name": "popover", "group": "surface", "light": "#ffffff", "dark": "#211e1b", "description": "Popover / menu surface" },
    { "name": "popover-foreground", "group": "surface", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on popover" },

    { "name": "primary", "group": "intent", "light": "#1c1917", "dark": "#ece8e3", "description": "Primary action / CTA fill — stone, NOT a brand color" },
    { "name": "primary-foreground", "group": "intent", "light": "#ffffff", "dark": "#1a1816", "description": "Text on primary" },
    { "name": "secondary", "group": "intent", "light": "#f5f5f4", "dark": "#2e2a26", "description": "Secondary surface / button" },
    { "name": "secondary-foreground", "group": "intent", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on secondary" },
    { "name": "muted", "group": "intent", "light": "#f5f5f4", "dark": "#2e2a26", "description": "Muted background" },
    { "name": "muted-foreground", "group": "intent", "light": "#57534e", "dark": "#a8a29e", "description": "Muted / secondary text" },
    { "name": "accent", "group": "intent", "light": "#f5f5f4", "dark": "#2e2a26", "description": "Accent hover surface" },
    { "name": "accent-foreground", "group": "intent", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on accent" },

    { "name": "destructive", "group": "functional", "light": "#c0502a", "dark": "#e0754a", "description": "Errors / destructive — warm terracotta (harmonizes with brand-3 coral)" },
    { "name": "destructive-foreground", "group": "functional", "light": "#ffffff", "dark": "#1a1816", "description": "Text on destructive" },

    { "name": "border", "group": "state", "light": "#e7e5e4", "dark": "#2e2a26", "description": "Hairline border" },
    { "name": "input", "group": "state", "light": "#e7e5e4", "dark": "#2e2a26", "description": "Input border" },
    { "name": "ring", "group": "state", "light": "#cbcac8", "dark": "#57534e", "description": "Focus ring" },

    { "name": "knowledge", "group": "functional", "light": "#8a8f4a", "dark": "#b6bd66", "description": "Knowledge / data streams — warm sage" },
    { "name": "knowledge-foreground", "group": "functional", "light": "#ffffff", "dark": "#1a1816", "description": "Text on knowledge" },
    { "name": "agent", "group": "functional", "light": "#7a4a6e", "dark": "#c58fb4", "description": "Agent / AI streams and chat — warm plum" },
    { "name": "agent-foreground", "group": "functional", "light": "#ffffff", "dark": "#1a1816", "description": "Text on agent" },

    { "name": "success", "group": "status", "light": "#5d8a4a", "dark": "#a6c56f", "description": "Positive / running status — warm green" },
    { "name": "success-foreground", "group": "status", "light": "#ffffff", "dark": "#1a1816", "description": "Text on success" },
    { "name": "warning", "group": "status", "light": "#c2751c", "dark": "#f5b544", "description": "Caution / booting status — warm amber" },
    { "name": "warning-foreground", "group": "status", "light": "#ffffff", "dark": "#1a1816", "description": "Text on warning" },

    { "name": "hover", "group": "state", "light": "rgba(28, 25, 23, 0.05)", "dark": "rgba(236, 232, 227, 0.06)", "description": "Hover overlay" },
    { "name": "active", "group": "state", "light": "rgba(28, 25, 23, 0.1)", "dark": "rgba(236, 232, 227, 0.12)", "description": "Active/pressed overlay" },
    { "name": "focus", "group": "state", "light": "rgba(203, 202, 200, 0.5)", "dark": "rgba(87, 83, 78, 0.6)", "description": "Focus overlay" },
    { "name": "disabled", "group": "state", "light": "#d6d3d1", "dark": "#3d3530", "description": "Disabled surface" },
    { "name": "disabled-foreground", "group": "state", "light": "#a8a29e", "dark": "#6b625a", "description": "Disabled text" },

    { "name": "sidebar-background", "group": "sidebar", "light": "#fafaf9", "dark": "#141210", "description": "Sidebar background" },
    { "name": "sidebar-foreground", "group": "sidebar", "light": "#1c1917", "dark": "#ece8e3", "description": "Sidebar text" },
    { "name": "sidebar-primary", "group": "sidebar", "light": "#1c1917", "dark": "#ece8e3", "description": "Sidebar primary" },
    { "name": "sidebar-primary-foreground", "group": "sidebar", "light": "#fafaf9", "dark": "#1a1816", "description": "Text on sidebar primary" },
    { "name": "sidebar-accent", "group": "sidebar", "light": "#f5f5f4", "dark": "#2e2a26", "description": "Sidebar accent surface" },
    { "name": "sidebar-accent-foreground", "group": "sidebar", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on sidebar accent" },
    { "name": "sidebar-border", "group": "sidebar", "light": "#e7e5e4", "dark": "#2e2a26", "description": "Sidebar border" },
    { "name": "sidebar-ring", "group": "sidebar", "light": "#a8a29e", "dark": "#57534e", "description": "Sidebar focus ring" },
    { "name": "sidebar", "group": "sidebar", "light": "#fafaf9", "dark": "#141210", "description": "Sidebar (alias)" }
  ]
}
