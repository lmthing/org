{
  "$meta": {
    "name": "lmthing design tokens",
    "description": "Single source of truth for the lmthing design system. Edit this file, then run `pnpm --filter @lmthing/css generate` to regenerate src/theme.css and tokens.manifest.json. Do NOT hand-edit theme.css.",
    "themes": ["light", "dark"],
    "darkSelector": "[data-theme=\"dark\"]",
    "notes": "Formal, low-chroma palette. Primary/CTA + focus ring are slate teal (#15505c light / #6aa8b4 dark); surfaces are cool and near-neutral (no warm cream tint); functional colors are desaturated. THE ONE THING THAT NEVER MOVES IS THE WORDMARK: logo-1..5 are frozen at the mark's five warm hues and are read ONLY by elements/branding/cozy-text. brand-1..5 are NOT the logo any more — they are the section/avatar ramp anchors (slate navy, teal, sage, taupe, muted plum) and follow the palette, as does the 50-stop --spectrum-* ramp interpolated from them. Anchors now differ between light and dark, so the ramp is cut per theme."
  },

  "theme": {
    "radius-sm": "0.125rem",
    "radius-md": "0.375rem",
    "radius": "0.375rem",
    "radius-lg": "0.5rem",
    "radius-xl": "0.75rem",
    "radius-full": "9999px",
    "font-sans": "Manrope, system-ui, sans-serif",
    "font-display": "Manrope, system-ui, sans-serif",
    "font-brand": "TypeMates Cera Round Pro Bold, system-ui, sans-serif",
    "font-mono": "JetBrains Mono, ui-monospace, monospace"
  },

  "spectrum": {
    "from": "brand-1",
    "to": "brand-5",
    "steps": 50,
    "group": "spectrum",
    "role": "surface",
    "description": "50-stop interpolated ramp from brand-1 (slate navy) through teal, sage and taupe to brand-5 (muted plum). Rotated across sidebar sections, tabs and avatars so they stay tellable apart without reading as a rainbow. Cut PER THEME, because the anchors differ between light and dark."
  },

  "colors": [
    { "name": "logo-1", "group": "logo", "role": "surface", "light": "#f5c815", "dark": "#f5c815", "description": "WORDMARK ONLY — letter 't', yellow (sunflower). FROZEN: the logo's five hues are the brand mark and must not change with the palette. Consumed solely by elements/branding/cozy-text; never use one as a general accent — that is what brand-1..5 are for." },
    { "name": "logo-2", "group": "logo", "role": "surface", "light": "#f9a94a", "dark": "#f9a94a", "description": "WORDMARK ONLY — letter 'h', amber. Frozen; see logo-1." },
    { "name": "logo-3", "group": "logo", "role": "surface", "light": "#f38358", "dark": "#f38358", "description": "WORDMARK ONLY — letter 'i', coral. Frozen; see logo-1." },
    { "name": "logo-4", "group": "logo", "role": "surface", "light": "#ed92a1", "dark": "#ed92a1", "description": "WORDMARK ONLY — letter 'n', rose. Frozen; see logo-1." },
    { "name": "logo-5", "group": "logo", "role": "surface", "light": "#d59ec8", "dark": "#d59ec8", "description": "WORDMARK ONLY — letter 'g', orchid. Frozen; see logo-1." },

    { "name": "brand-1", "group": "brand", "role": "surface", "light": "#2c4763", "dark": "#7f9ab8", "description": "Section/avatar ramp anchor 1 - slate navy. NOT the wordmark: the logo reads logo-1..5" },
    { "name": "brand-2", "group": "brand", "role": "surface", "light": "#2f6270", "dark": "#78a8b4", "description": "Section/avatar ramp anchor 2 - teal" },
    { "name": "brand-3", "group": "brand", "role": "surface", "light": "#4b7a63", "dark": "#8db09b", "description": "Section/avatar ramp anchor 3 - sage" },
    { "name": "brand-4", "group": "brand", "role": "surface", "light": "#7a7350", "dark": "#b0a887", "description": "Section/avatar ramp anchor 4 - taupe" },
    { "name": "brand-5", "group": "brand", "role": "surface", "light": "#6b4f63", "dark": "#a98ea1", "description": "Section/avatar ramp anchor 5 - muted plum" },

    { "name": "neutral-1", "group": "neutral", "role": "surface", "light": "#c3c8ce", "dark": "#737a82", "description": "Cool neutral (was warm stone)" },
    { "name": "neutral", "group": "neutral", "role": "surface", "light": "#c3c8ce", "dark": "#737a82", "description": "Alias of neutral-1" },

    { "name": "background", "group": "surface", "role": "surface", "light": "#fcfcfd", "dark": "#101317", "description": "Page background - cool, near-neutral" },
    { "name": "foreground", "group": "surface", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Default body text" },
    { "name": "card", "group": "surface", "role": "surface", "light": "#ffffff", "dark": "#171b20", "description": "Card / raised surface" },
    { "name": "card-foreground", "group": "surface", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Text on card" },
    { "name": "popover", "group": "surface", "role": "surface", "light": "#ffffff", "dark": "#171b20", "description": "Popover / menu surface" },
    { "name": "popover-foreground", "group": "surface", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Text on popover" },

    { "name": "primary", "group": "intent", "role": "surface", "light": "#15505c", "dark": "#6aa8b4", "description": "Primary action / CTA fill - slate teal" },
    { "name": "primary-foreground", "group": "intent", "role": "text", "light": "#ffffff", "dark": "#101214", "description": "Text on primary" },
    { "name": "secondary", "group": "intent", "role": "surface", "light": "#f2f4f6", "dark": "#1e232a", "description": "Secondary surface / button" },
    { "name": "secondary-foreground", "group": "intent", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Text on secondary" },
    { "name": "muted", "group": "intent", "role": "surface", "light": "#f2f4f6", "dark": "#1e232a", "description": "Muted background" },
    { "name": "muted-foreground", "group": "intent", "role": "text", "light": "#5c636b", "dark": "#98a0a9", "description": "Muted / secondary text - also the wordmark lm prefix" },
    { "name": "accent", "group": "intent", "role": "surface", "light": "#eceef1", "dark": "#20252b", "description": "Accent hover surface" },
    { "name": "accent-foreground", "group": "intent", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Text on accent" },

    { "name": "destructive", "group": "functional", "role": "surface", "light": "#a8322a", "dark": "#d4685c", "description": "Errors / destructive" },
    { "name": "destructive-foreground", "group": "functional", "role": "text", "light": "#ffffff", "dark": "#15100f", "description": "Text on destructive" },

    { "name": "border", "group": "state", "role": "surface", "light": "#e4e7ea", "dark": "#262c33", "description": "Hairline border" },
    { "name": "input", "group": "state", "role": "surface", "light": "#e4e7ea", "dark": "#262c33", "description": "Input border" },
    { "name": "ring", "group": "state", "role": "surface", "light": "#15505c", "dark": "#6aa8b4", "description": "Focus ring - slate teal" },

    { "name": "knowledge", "group": "functional", "role": "surface", "light": "#4a6b52", "dark": "#7fa78c", "description": "Knowledge / data streams - muted green" },
    { "name": "knowledge-foreground", "group": "functional", "role": "text", "light": "#ffffff", "dark": "#0f1512", "description": "Text on knowledge" },
    { "name": "agent", "group": "functional", "role": "surface", "light": "#54476b", "dark": "#9b8bb5", "description": "Agent / AI streams and chat - muted violet" },
    { "name": "agent-foreground", "group": "functional", "role": "text", "light": "#ffffff", "dark": "#111017", "description": "Text on agent" },

    { "name": "success", "group": "status", "role": "surface", "light": "#2c6b48", "dark": "#63a684", "description": "Positive / running status" },
    { "name": "success-foreground", "group": "status", "role": "text", "light": "#ffffff", "dark": "#0c1512", "description": "Text on success" },
    { "name": "warning", "group": "status", "role": "surface", "light": "#96690b", "dark": "#cb9c3f", "description": "Caution / booting status" },
    { "name": "warning-foreground", "group": "status", "role": "text", "light": "#ffffff", "dark": "#161310", "description": "Text on warning" },

    { "name": "hover", "group": "state", "role": "surface", "light": "rgba(21, 80, 92, 0.06)", "dark": "rgba(106, 168, 180, 0.06)", "description": "Hover overlay - slate teal" },
    { "name": "active", "group": "state", "role": "surface", "light": "rgba(21, 80, 92, 0.13)", "dark": "rgba(106, 168, 180, 0.13)", "description": "Active/pressed overlay" },
    { "name": "focus", "group": "state", "role": "surface", "light": "rgba(21, 80, 92, 0.35)", "dark": "rgba(106, 168, 180, 0.35)", "description": "Focus overlay" },
    { "name": "disabled", "group": "state", "role": "surface", "light": "#e9ecef", "dark": "#2b2d30", "description": "Disabled surface" },
    { "name": "disabled-foreground", "group": "state", "role": "text", "light": "#a3a9b0", "dark": "#66686b", "description": "Disabled text" },
    { "name": "scrim", "group": "intent", "role": "surface", "light": "rgba(0,0,0,0.5)", "dark": "rgba(0,0,0,0.5)", "description": "Modal/overlay wash — achromatic and identical in both themes, so a dialog behind it dims the same way on either" },

    { "name": "sidebar-background", "group": "sidebar", "role": "surface", "light": "#f7f8fa", "dark": "#0c0f12", "description": "Sidebar background" },
    { "name": "sidebar-foreground", "group": "sidebar", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Sidebar text" },
    { "name": "sidebar-primary", "group": "sidebar", "role": "surface", "light": "#15505c", "dark": "#6aa8b4", "description": "Sidebar primary / active item" },
    { "name": "sidebar-primary-foreground", "group": "sidebar", "role": "text", "light": "#ffffff", "dark": "#101214", "description": "Text on sidebar primary" },
    { "name": "sidebar-accent", "group": "sidebar", "role": "surface", "light": "#eceef1", "dark": "#20252b", "description": "Sidebar accent / hover surface" },
    { "name": "sidebar-accent-foreground", "group": "sidebar", "role": "text", "light": "#14171a", "dark": "#e7eaed", "description": "Text on sidebar accent" },
    { "name": "sidebar-border", "group": "sidebar", "role": "surface", "light": "#e4e7ea", "dark": "#262c33", "description": "Sidebar border" },
    { "name": "sidebar-ring", "group": "sidebar", "role": "surface", "light": "#15505c", "dark": "#6aa8b4", "description": "Sidebar focus ring" },
    { "name": "sidebar", "group": "sidebar", "role": "surface", "light": "#f7f8fa", "dark": "#0c0f12", "description": "Sidebar (alias)" }
  ]
}
