{
  "$meta": {
    "name": "lmthing design tokens",
    "description": "Single source of truth for the lmthing design system. Edit this file, then run `pnpm --filter @lmthing/css generate` to regenerate src/theme.css and tokens.manifest.json. Do NOT hand-edit theme.css.",
    "themes": ["light", "dark"],
    "darkSelector": "[data-theme=\"dark\"]",
    "notes": "Colorful warm palette: the cozy rainbow leads. Primary/CTA + focus ring are brand coral (brand-3); surfaces (bg/card/sidebar) carry a faint warm brand tint; functional colors are saturated. The rainbow (brand + spectrum) is unchanged across light/dark and is rotated across sections/avatars via the --spectrum-* ramp. Neutrals stay warm stone (no cool grey, no blue)."
  },

  "theme": {
    "radius-sm": "0.125rem",
    "radius-md": "0.375rem",
    "radius": "0.375rem",
    "radius-lg": "0.5rem",
    "radius-xl": "0.75rem",
    "radius-full": "9999px",
    "font-sans": "TypeMates Cera Round Pro Bold, system-ui, sans-serif",
    "font-display": "TypeMates Cera Round Pro Bold, system-ui, sans-serif",
    "font-mono": "ui-monospace, monospace"
  },

  "spectrum": {
    "from": "brand-1",
    "to": "brand-5",
    "steps": 50,
    "group": "spectrum",
    "role": "surface",
    "description": "50-stop interpolated ramp from brand-1 (yellow) through the warm arc to brand-5 (orchid). Rotated across sidebar sections, tabs and avatars for the full-spectrum look. Identical in light and dark."
  },

  "colors": [
    { "name": "brand-1", "group": "brand", "role": "surface", "light": "#f5c815", "dark": "#f5c815", "description": "THING letter 't' — yellow (sunflower)" },
    { "name": "brand-2", "group": "brand", "role": "surface", "light": "#f9a94a", "dark": "#f9a94a", "description": "THING letter 'h' — amber" },
    { "name": "brand-3", "group": "brand", "role": "surface", "light": "#f38358", "dark": "#f38358", "description": "THING letter 'i' — coral (the primary/CTA anchor)" },
    { "name": "brand-4", "group": "brand", "role": "surface", "light": "#ed92a1", "dark": "#ed92a1", "description": "THING letter 'n' — rose" },
    { "name": "brand-5", "group": "brand", "role": "surface", "light": "#d59ec8", "dark": "#d59ec8", "description": "THING letter 'g' — orchid" },

    { "name": "neutral-1", "group": "neutral", "role": "surface", "light": "#cbcac8", "dark": "#8a8175", "description": "Warm stone neutral (never cool grey)" },
    { "name": "neutral", "group": "neutral", "role": "surface", "light": "#cbcac8", "dark": "#8a8175", "description": "Alias of neutral-1" },

    { "name": "background", "group": "surface", "role": "surface", "light": "#fffdfb", "dark": "#1a1512", "description": "Page background — faint warm tint" },
    { "name": "foreground", "group": "surface", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Default body text" },
    { "name": "card", "group": "surface", "role": "surface", "light": "#fffaf6", "dark": "#221c18", "description": "Card / raised surface — subtle warm tint" },
    { "name": "card-foreground", "group": "surface", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on card" },
    { "name": "popover", "group": "surface", "role": "surface", "light": "#fffaf6", "dark": "#221c18", "description": "Popover / menu surface" },
    { "name": "popover-foreground", "group": "surface", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on popover" },

    { "name": "primary", "group": "intent", "role": "surface", "light": "#f38358", "dark": "#f38358", "description": "Primary action / CTA fill — brand coral (brand-3)" },
    { "name": "primary-foreground", "group": "intent", "role": "text", "light": "#2b1a12", "dark": "#2b1a12", "description": "Text on primary — warm near-black for AA contrast on coral" },
    { "name": "secondary", "group": "intent", "role": "surface", "light": "#f7f1ec", "dark": "#2e2723", "description": "Secondary surface / button — warm" },
    { "name": "secondary-foreground", "group": "intent", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on secondary" },
    { "name": "muted", "group": "intent", "role": "surface", "light": "#f7f1ec", "dark": "#2e2723", "description": "Muted background — warm" },
    { "name": "muted-foreground", "group": "intent", "role": "text", "light": "#57534e", "dark": "#a8a29e", "description": "Muted / secondary text" },
    { "name": "accent", "group": "intent", "role": "surface", "light": "#fbe7dd", "dark": "#34271f", "description": "Accent hover surface — warm coral tint" },
    { "name": "accent-foreground", "group": "intent", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on accent" },

    { "name": "destructive", "group": "functional", "role": "surface", "light": "#bd3b28", "dark": "#e0754a", "description": "Errors / destructive — deep red-terracotta (distinct from coral primary)" },
    { "name": "destructive-foreground", "group": "functional", "role": "text", "light": "#ffffff", "dark": "#1a1816", "description": "Text on destructive" },

    { "name": "border", "group": "state", "role": "surface", "light": "#efe6df", "dark": "#2f2620", "description": "Hairline border — warm" },
    { "name": "input", "group": "state", "role": "surface", "light": "#efe6df", "dark": "#2f2620", "description": "Input border" },
    { "name": "ring", "group": "state", "role": "surface", "light": "#f38358", "dark": "#f38358", "description": "Focus ring — brand coral" },

    { "name": "knowledge", "group": "functional", "role": "surface", "light": "#8f9a2b", "dark": "#c2ca5e", "description": "Knowledge / data streams — vivid sage" },
    { "name": "knowledge-foreground", "group": "functional", "role": "text", "light": "#ffffff", "dark": "#1a1816", "description": "Text on knowledge" },
    { "name": "agent", "group": "functional", "role": "surface", "light": "#944a80", "dark": "#cf94bd", "description": "Agent / AI streams and chat — vivid plum" },
    { "name": "agent-foreground", "group": "functional", "role": "text", "light": "#ffffff", "dark": "#1a1816", "description": "Text on agent" },

    { "name": "success", "group": "status", "role": "surface", "light": "#4f9a2f", "dark": "#a6c56f", "description": "Positive / running status — vivid green" },
    { "name": "success-foreground", "group": "status", "role": "text", "light": "#ffffff", "dark": "#1a1816", "description": "Text on success" },
    { "name": "warning", "group": "status", "role": "surface", "light": "#dd8410", "dark": "#f5b544", "description": "Caution / booting status — vivid amber" },
    { "name": "warning-foreground", "group": "status", "role": "text", "light": "#ffffff", "dark": "#1a1816", "description": "Text on warning" },

    { "name": "hover", "group": "state", "role": "surface", "light": "rgba(243, 131, 88, 0.08)", "dark": "rgba(243, 131, 88, 0.12)", "description": "Hover overlay — faint coral" },
    { "name": "active", "group": "state", "role": "surface", "light": "rgba(243, 131, 88, 0.16)", "dark": "rgba(243, 131, 88, 0.22)", "description": "Active/pressed overlay — coral" },
    { "name": "focus", "group": "state", "role": "surface", "light": "rgba(243, 131, 88, 0.4)", "dark": "rgba(243, 131, 88, 0.5)", "description": "Focus overlay — coral" },
    { "name": "disabled", "group": "state", "role": "surface", "light": "#e7e0da", "dark": "#3d3530", "description": "Disabled surface" },
    { "name": "disabled-foreground", "group": "state", "role": "text", "light": "#a8a29e", "dark": "#6b625a", "description": "Disabled text" },
    { "name": "scrim", "group": "intent", "role": "surface", "light": "rgba(0,0,0,0.5)", "dark": "rgba(0,0,0,0.5)", "description": "Modal/overlay wash — achromatic and identical in both themes, so a dialog behind it dims the same way on either" },

    { "name": "sidebar-background", "group": "sidebar", "role": "surface", "light": "#fdf5ef", "dark": "#17120f", "description": "Sidebar background — warm brand tint" },
    { "name": "sidebar-foreground", "group": "sidebar", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Sidebar text" },
    { "name": "sidebar-primary", "group": "sidebar", "role": "surface", "light": "#f38358", "dark": "#f38358", "description": "Sidebar primary / active item — brand coral" },
    { "name": "sidebar-primary-foreground", "group": "sidebar", "role": "text", "light": "#2b1a12", "dark": "#2b1a12", "description": "Text on sidebar primary" },
    { "name": "sidebar-accent", "group": "sidebar", "role": "surface", "light": "#fbe7dd", "dark": "#2e241e", "description": "Sidebar accent / hover surface — warm coral tint" },
    { "name": "sidebar-accent-foreground", "group": "sidebar", "role": "text", "light": "#1c1917", "dark": "#ece8e3", "description": "Text on sidebar accent" },
    { "name": "sidebar-border", "group": "sidebar", "role": "surface", "light": "#f2e4da", "dark": "#2f2620", "description": "Sidebar border — warm" },
    { "name": "sidebar-ring", "group": "sidebar", "role": "surface", "light": "#f38358", "dark": "#f38358", "description": "Sidebar focus ring — coral" },
    { "name": "sidebar", "group": "sidebar", "role": "surface", "light": "#fdf5ef", "dark": "#17120f", "description": "Sidebar (alias)" }
  ]
}
