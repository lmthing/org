{
  "name": "@lmthing/ui",
  "version": "1.0.0",
  "description": "LMThing shared UI - elements, components, and product surfaces (chat/studio/computer)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./team": "./src/team/index.ts",
    "./view": "./src/view/index.ts",
    "./dashboard": "./src/dashboard/index.ts",
    "./chat/css": "./src/chat/app/styles.css",
    "./studio": "./src/studio/index.ts",
    "./computer": "./src/computer/index.ts",
    "./components/*": [
      "./src/components/*/index.tsx",
      "./src/components/*/index.ts"
    ],
    "./elements/*": [
      "./src/elements/*/index.tsx",
      "./src/elements/*/index.ts",
      "./src/elements/*.tsx",
      "./src/elements/*.ts"
    ],
    "./elements/primitives": "./src/elements/primitives/index.ts",
    "./lib/*": "./src/lib/*",
    "./platform": "./src/platform/index.ts",
    "./theme": "./src/theme/index.ts",
    "./theme/tamagui.config": "./src/theme/tamagui.config.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "lmthing-lint-tokens src",
    "lint:rn": "node scripts/lint-rn-safety.mjs",
    "lint": "tsc --noEmit && eslint . && lmthing-lint-tokens src && node scripts/lint-rn-safety.mjs && node scripts/lint-import-extensions.mjs && node scripts/lint-self-imports.mjs && node scripts/lint-relative-transport.mjs && node scripts/lint-dom-globals.mjs && node scripts/lint-native-forks.mjs && node scripts/lint-no-tailwind.mjs",
    "format": "prettier --write .",
    "test:native": "node ../../scripts/check-workspace-links.mjs && node metro/cli.mjs",
    "test:native:gate": "node ../../scripts/check-workspace-links.mjs && node metro/cli.mjs --gate",
    "lint:imports": "node scripts/lint-import-extensions.mjs",
    "lint:tailwind": "node scripts/lint-no-tailwind.mjs",
    "lint:self-imports": "node scripts/lint-self-imports.mjs",
    "lint:forks": "node scripts/lint-native-forks.mjs",
    "lint:dom": "node scripts/lint-dom-globals.mjs"
  },
  "dependencies": {
    "@lmthing/auth": "workspace:*",
    "@lmthing/core": "workspace:*",
    "@lmthing/css": "workspace:*",
    "@tamagui/animations-css": "2.5.1",
    "@tamagui/animations-react-native": "2.5.1",
    "@tamagui/core": "^2.5.1",
    "@tamagui/lucide-icons-2": "2.5.1",
    "marked": "^14.0.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@lmthing/config": "workspace:*",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-babel-transformer": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.2",
    "clsx": "^2.1.1",
    "eslint": "^9.0.0",
    "expo-clipboard": "~57.0.1",
    "expo-linking": "^57.0.4",
    "jsdom": "^24.1.3",
    "metro": "^0.87.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-test-renderer": "19.2.0"
  },
  "peerDependencies": {
    "@monaco-editor/react": "*",
    "@react-native-async-storage/async-storage": "*",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@xterm/addon-fit": "*",
    "@xterm/addon-web-links": "*",
    "@xterm/xterm": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "expo-clipboard": "*",
    "expo-linking": "*",
    "lucide-react": "*",
    "react": ">=19",
    "react-dom": ">=19",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-webview": "*"
  },
  "author": "LMThing",
  "license": "MIT",
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "@monaco-editor/react": {
      "optional": true
    },
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/addon-web-links": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    }
  }
}
