{
  "name": "@lmthing/ui",
  "version": "1.0.0",
  "description": "LMThing shared UI - elements, components, and product surfaces (chat/studio/computer)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./chat/css": "./src/chat/app/styles.css",
    "./studio": "./src/studio/index.ts",
    "./computer": "./src/computer/index.ts",
    "./components/*": "./src/components/*/index.ts",
    "./elements/*": "./src/elements/*",
    "./elements/primitives": "./src/elements/primitives/index.ts",
    "./lib/*": "./src/lib/*",
    "./theme": "./src/theme/index.ts",
    "./theme/tamagui.config": "./src/theme/tamagui.config.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "lmthing-lint-tokens src",
    "lint:rn": "node scripts/lint-rn-safety.mjs",
    "lint": "tsc --noEmit && eslint . && lmthing-lint-tokens src && node scripts/lint-rn-safety.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lmthing/auth": "workspace:*",
    "@lmthing/core": "workspace:*",
    "@lmthing/css": "workspace:*",
    "@tamagui/animations-css": "2.5.1",
    "@tamagui/animations-react-native": "2.5.1",
    "@tamagui/core": "^2.5.1",
    "@tamagui/lucide-icons": "2.0.0-rc.26",
    "marked": "^14.0.0",
    "modern-screenshot": "^4.6.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.2",
    "clsx": "^2.1.1",
    "eslint": "^9.0.0",
    "jsdom": "^24.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "@monaco-editor/react": "*",
    "@react-native-async-storage/async-storage": "*",
    "@react-native-clipboard/clipboard": "*",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@xterm/addon-fit": "*",
    "@xterm/addon-web-links": "*",
    "@xterm/xterm": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": ">=19",
    "react-dom": ">=19",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-webview": "*",
    "tailwind-merge": "*"
  },
  "author": "LMThing",
  "license": "MIT",
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    },
    "@react-native-clipboard/clipboard": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@monaco-editor/react": {
      "optional": true
    },
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/addon-web-links": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    }
  }
}
