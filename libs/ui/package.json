{
  "name": "@lmthing/ui",
  "version": "1.0.0",
  "description": "LMThing shared UI - elements, components, and product surfaces (chat/studio/computer)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./chat/css": "./src/chat/app/styles.css",
    "./studio": "./src/studio/index.ts",
    "./computer": "./src/computer/index.ts",
    "./components/*": "./src/components/*/index.ts",
    "./elements/*": "./src/elements/*",
    "./elements/primitives": "./src/elements/primitives/index.ts",
    "./lib/*": "./src/lib/*",
    "./theme": "./src/theme/index.ts",
    "./theme/tamagui.config": "./src/theme/tamagui.config.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "lint:tokens": "lmthing-lint-tokens src",
    "lint:rn": "node scripts/lint-rn-safety.mjs",
    "lint": "eslint . && lmthing-lint-tokens src && node scripts/lint-rn-safety.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lmthing/auth": "workspace:*",
    "@lmthing/core": "workspace:*",
    "@lmthing/css": "workspace:*",
    "@tamagui/core": "^2.5.1",
    "@tamagui/lucide-icons": "2.0.0-rc.26",
    "marked": "^14.0.0",
    "modern-screenshot": "^4.6.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "clsx": "^2.1.1",
    "eslint": "^9.0.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "@monaco-editor/react": "*",
    "@xterm/addon-fit": "*",
    "@xterm/addon-web-links": "*",
    "@xterm/xterm": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "*"
  },
  "author": "LMThing",
  "license": "MIT"
}
