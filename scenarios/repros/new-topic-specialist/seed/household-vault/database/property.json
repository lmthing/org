    "interest_rate_pct": {
      "type": "number",
      "description": "Current fixed interest rate"
    },
    "fixed_rate_until": {
      "type": "string",
      "description": "Date the fixed-rate period expires, ISO 8601"
    },
    "title_deed_ref": {
      "type": "string",
      "description": "Title deed reference — plot, deed number, registry"
    },
    "land_registry": {
      "type": "string",
      "description": "Land registry office, e.g. Kallithea"
    },
    "emergency_fund_eur": {
      "type": "number",
      "description": "Emergency savings balance in euros"
    },
    "emergency_fund_account": {
      "type": "string",
      "description": "IBAN or account identifier for the emergency fund"
    },
    "equity_pct": {
      "type": "number",
      "description": "Current equity percentage — (original - remaining) / original * 100"
    },
    "notes": {
      "type": "string",
      "description": "Extra notes"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 last-update timestamp"
