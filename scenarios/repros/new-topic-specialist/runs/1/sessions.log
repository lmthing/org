[stmt] // Build the source for the PUT endpoint — updates an existing vaccine row by id
const src = [
  "export const name = '" + name + "';",
  "export const description = 'Updates an existing vaccine record by its id. Serves story: update-vaccine-record.';",
  "export interface Input {",
  "  id: string;",
  "  dog_id?: string;",
  "  vaccine_name?: string;",
  "  date_given?: string;",
  "  expiry_date?: string;",
  "  notes?: string;",
  "}",
  "export interface Output {",
  "  items: {",
  "    id: string;",
  "    dog_id: string;",
  "    vaccine_name: string;",
  "    date_given: string;",
  "    expiry_date: string;",
  "    notes: string;",
  "    created_at: string;",
  "    updated_at: string;",
  "  }[];",
  "}",
  "export default async function handler(input: Input, ctx: { db: any }): Promise<Output> {",
  "  const id = input.id;",
  "  const existing = await ctx.db.query('vaccines', { where: { id } });",
  "  if (!existing || existing.length === 0) {",
  "    throw new Error('Vaccine record not found');",
  "  }",
  "  const record = existing[0];",
  "  const updated = {",
  "    ...record,",
  "    dog_id: input.dog_id ?? record.dog_id,",
  "    vaccine_name: input.vaccine_name ?? record.vaccine_name,",
  "    date_given: input.date_given ?? record.date_given,",
  "    expiry_date: input.expiry_date ?? record.expiry_date,",
  "    notes: input.notes ?? record.notes,",
  "    updated_at: new Date().toISOString(),",
  "  };",
  "  const result = await ctx.db.update('vaccines', id, updated);",
  "  return { items: [result] };",
  "}",
].join("\n");
[stmt] const w = writeProjectApi(ep.route, src);
[stmt] currentTask.resolve({ route: ep.route, name, ok: w.ok });
