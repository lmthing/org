// Now I see the real pattern: `export default async function handler(input: Input, ctx: { db: any }): Promise<Output>`.
// The POST handler MUST follow this same shape — no Request/Response, no `req.json()`, no `res.status()`.
// Input: dog_id, vaccine_name, date_given, expiry_date, notes. Output: the created vaccine row.
// The DB layer auto-generates `id` via `ctx.db.insert`.
const fixed3 = `export const name = 'vaccine-create';
export const description = 'Creates a new vaccine record linked to a dog by dog_id. Serves story: add-new-vaccine.';

export interface Input {
  dog_id: string;
  vaccine_name: string;
  date_given?: string;
  expiry_date?: string;
  notes?: string;
}

export interface Output {
  id: string;
  dog_id: string;
  vaccine_name: string;
  date_given: string;
  expiry_date: string;
  notes: string;
  created_at: string;
  updated_at: string;
}

export default async function handler(input: Input, ctx: { db: any }): Promise<Output> {
  if (!input.dog_id || !input.vaccine_name) {
    throw new Error('dog_id and vaccine_name are required');
  }

  const row = await ctx.db.insert('vaccines', {
    dog_id: input.dog_id,
    vaccine_name: input.vaccine_name,
    date_given: input.date_given ?? null,
    expiry_date: input.expiry_date ?? null,
    notes: input.notes ?? null,
  });

  return {
    id: row.id,
    dog_id: row.dog_id,
    vaccine_name: row.vaccine_name,
    date_given: row.date_given,
    expiry_date: row.expiry_date,
    notes: row.notes,
    created_at: row.created_at,
    updated_at: row.updated_at,
  };
}
`;
