[stmt] // Build the handler source that queries all vaccines and computes expiring_soon
const src = [
  "export const name = '" + name + "';",
  "export const description = '" + String(ep.purpose).replace(/'/g, "") + "';",
  "export interface Input { dog_id?: string }",
  "export interface Output { items: { id: string; dog_id: string; vaccine_name: string; date_given: string; expiry_date: string; notes: string; created_at: string; updated_at: string; expiring_soon: boolean }[] }",
  "export default async function handler(input: Input, ctx: { db: any }): Promise<Output> {",
  "  const rows = await ctx.db.query('" + table + "');",
  "  const now = new Date();",
  "  const thirtyDaysFromNow = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);",
  "  const items = rows",
  "    .filter((r: any) => !input.dog_id || r.dog_id === input.dog_id)",
  "    .map((r: any) => ({",
  "      id: r.id,",
  "      dog_id: r.dog_id,",
  "      vaccine_name: r.vaccine_name,",
  "      date_given: r.date_given,",
  "      expiry_date: r.expiry_date,",
  "      notes: r.notes,",
  "      created_at: r.created_at,",
  "      updated_at: r.updated_at,",
  "      expiring_soon: r.expiry_date ? new Date(r.expiry_date) <= thirtyDaysFromNow : false,",
  "    }));",
  "  return { items };",
  "}",
].join("\n");
[stmt] const w = writeProjectApi(ep.route, src);
[stmt] // w is { ok, error? } — branch on w.ok
const ok = w.ok;
