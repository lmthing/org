// `item.fields` dictates the exact keys for Output, and we must use them verbatim.
// The table seed has one row for Άργος (id: 8c6c18c9-5718-4829-aa43-49b4ae6188f9).

const ep = item;
const name = ep.name;
const table = "dogs";
// Construct the ESM module source: typed Input/Output matching item.fields exactly,
// handler queries ctx.db for the dogs table and returns the matching row by id.
const src = [
  "export const name = '" + name + "';",
  "export const description = '" + String(ep.purpose).replace(/'/g, "\\'") + "';",
  "",
  "export interface Input {",
  "  id: string;",
  "}",
  "",
  "export interface Output {",
  "  items: {",
  "    id: string;",
  "    name: string;",
  "    microchip_number: string;",
  "    vet_name: string;",
  "    vet_location: string;",
  "    weight_kg: number;",
  "    created_at: string;",
  "    updated_at: string;",
  "  }[];",
  "}",
  "",
  "export default async function handler(input: Input, ctx: { db: any }): Promise<Output> {",
  "  const rows = await ctx.db.query('" + table + "');",
  "  const dog = rows.find((r: any) => r.id === input.id);",
  "  const items = dog ? [dog] : [];",
  "  return { items };",
  "}",
].join("\n");
const w = writeProjectApi(ep.route, src);
// If the write failed, report the error so the host can retry.
currentTask.resolve({ route: ep.route, name, ok: w.ok });
