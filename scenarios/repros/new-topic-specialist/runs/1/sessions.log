[stmt] // The project is empty — no existing tables or pages. This is a from-scratch build.
// Now, trace EVERY user story to its concrete artifacts.

// STORY TRACE:
// view-dog-details → reads dogs table → dog detail page shows card
// list-dog-vaccines → reads vaccines table (joined on dog_id) → dog detail page shows list
// add-new-vaccine → POST to vaccines endpoint → form on dog detail page
// see-expiring-vaccines → reads vaccines with expiry filter → warning badge on detail page (computed client-side from today vs expiry_date)
// automated-expiry-reminder → cron hook checks vaccines daily, fires trigger for expiring ones → trigger shows notification
// update-vaccine-record → PUT/PATCH to vaccines endpoint → inline edit form on detail page
// remove-vaccine-record → DELETE to vaccines endpoint → delete action on row

// TABLE PLAN:
// - dogs: the one-and-only dog row from the source (Άργος). ONE table, ONE seed row.
// - vaccines: FK to dogs, one seed row (Αντιλυσσικό), grows with user additions.
// Both tables have real seed data from the source. No orphan tables needed —
// every source value lands in one of these two tables.

// PAGE PLAN:
// - index: home page — redirects to the dog detail page OR shows a summary card for Άργος linking into detail. Since there is only one dog, the home IS effectively the dog detail page. We'll make index the dog detail page directly (shows dog card + vaccine list + add form + expiring badges).
// No need for separate list/dashboard pages — the detail page serves all stories in one view.

// ENDPOINT PLAN:
// - dogs/1/GET — read the dog row
// - vaccines/GET — read all vaccines (filtered by dog_id via query param)
// - vaccines/POST — add a new vaccine
// - vaccines/:id/PUT — update a vaccine
// - vaccines/:id/DELETE — delete a vaccine

// COMPONENT PLAN:
// - DogCard — reusable card displaying dog fields (name, microchip, vet, location, weight)
// - VaccineRow — single vaccine row with name, dates, notes, and action buttons
// - VaccineForm — the add/edit form for vaccines
// - ExpiryBadge — the warning badge shown when a vaccine is expiring within 30 days

currentTask.resolve({
  title: 'Άργος — Dog Vaccine Tracker',
  purpose: 'Track the dog Άργος\'s vaccination records and get reminders when vaccines are about to expire.',
  tables: [
    {
      name: 'dogs',
      purpose: 'Stores the dog profile (name, microchip, vet, location, weight). Serves stories: view-dog-details. One seed row for Άργος.'
    },
    {
      name: 'vaccines',
      purpose: 'Stores vaccine records linked to a dog via dog_id FK. Serves stories: list-dog-vaccines, add-new-vaccine, see-expiring-vaccines, update-vaccine-record, remove-vaccine-record, automated-expiry-reminder. One seed row: Αντιλυσσικό.'
    }
  ],
  endpoints: [
    { route: 'dogs/1/GET', purpose: 'Returns the single dog profile row for Άργος.' },
    { route: 'vaccines/GET', purpose: 'Returns all vaccine rows, optionally filtered by dog_id query param.' },
    { route: 'vaccines/POST', purpose: 'Creates a new vaccine record linked to a dog.' },
    { route: 'vaccines/:id/PUT', purpose: 'Updates an existing vaccine record by id.' },
    { route: 'vaccines/:id/DELETE', purpose: 'Deletes a vaccine record by id.' }
  ],
  components: [
    { name: 'DogCard', purpose: 'Read-only card displaying all dog fields (name, microchip, vet, location, weight).' },
    { name: 'VaccineRow', purpose: 'Single vaccine row showing vaccine_name, date_given, expiry_date, notes, expiry badge, and edit/delete actions.' },
    { name: 'VaccineForm', purpose: 'Form for adding or editing a vaccine (vaccine_name, date_given, expiry_date, notes). Used in both create and edit modes.' },
    { name: 'ExpiryBadge', purpose: 'Warning badge displayed when vaccine expiry_date is within 30 days of today. Shows "Expiring soon" label.' }
  ],
  pages: [
    {
      route: 'index',
      purpose: 'Home page — the dog detail view for Άργος. Shows DogCard, the full vaccine list with ExpiryBadge warnings, and the VaccineForm to add new vaccines. Serves ALL stories: view-dog-details, list-dog-vaccines, add-new-vaccine, see-expiring-vaccines, update-vaccine-record, remove-vaccine-record.'
    }
  ]
});
