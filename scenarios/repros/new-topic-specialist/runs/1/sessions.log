  "import { useState } from 'react';",
  "import { useApi, useApiMutation } from '@app/runtime';",
  "import DogCard from '../components/DogCard';",
  "import VaccineRow from '../components/VaccineRow';",
  "export default function Page() {",
  "  const [showForm, setShowForm] = useState(false);",
  "  const [editingVaccine, setEditingVaccine] = useState<{ id: string; vaccine_name: string; date_given: string; expiry_date: string; notes: string } | null>(null);",
  "  const { data: dogData, isLoading: dogLoading, error: dogError } = useApi<{ items: { id: string; name: string; microchip_number: string; vet_name: string; vet_location: string; weight_kg: number }[] }>('dogs-list');",
  "  const dog = (dogData?.items ?? [])[0];",
  "  const { data: vaxData, isLoading: vaxLoading, error: vaxError } = useApi<{ items: { id: string; dog_id: string; vaccine_name: string; date_given: string; expiry_date: string; notes: string }[] }>(dog ? 'vaccines-list' : 'vaccines-list');",
  "  const createMutation = useApiMutation('vaccine-create');",
  "  const updateMutation = useApiMutation('vaccine-update');",
  "  const deleteMutation = useApiMutation('vaccine-delete');",
  "  if (dogLoading || vaxLoading) return <p className=\"p-4 text-muted\">Loading…</p>;",
  "  if (dogError || vaxError) return <p className=\"p-4 text-destructive\">Could not load data.</p>;",
  "  const vaccines = vaxData?.items ?? [];",
  "  const handleCreate = async (formData: { vaccine_name: string; date_given: string; expiry_date: string; notes: string }) => {",
  "    if (!dog) return;",
  "    await createMutation.mutate({ dog_id: dog.id, vaccine_name: formData.vaccine_name, date_given: formData.date_given, expiry_date: formData.expiry_date, notes: formData.notes });",
  "    setShowForm(false);",
  "  };",
  "  const handleUpdate = async (formData: { vaccine_name: string; date_given: string; expiry_date: string; notes: string }) => {",
  "    if (!editingVaccine) return;",
  "    await updateMutation.mutate({ id: editingVaccine.id, vaccine_name: formData.vaccine_name, date_given: formData.date_given, expiry_date: formData.expiry_date, notes: formData.notes });",
  "    setEditingVaccine(null);",
  "    setShowForm(false);",
  "  };",
  "  const handleDelete = async (vaccineId: string) => {",
  "    await deleteMutation.mutate({ id: vaccineId });",
  "  };",
  "  return (",
  "    <main className=\"space-y-6 p-4 max-w-2xl mx-auto\">",
  "      {dog ? (",
  "        <DogCard dog={{ id: dog.id, name: dog.name, microchip_number: dog.microchip_number, vet_name: dog.vet_name, vet_location: dog.vet_location, weight_kg: dog.weight_kg }} />",
  "      ) : (",
  "        <p className=\"text-muted\">No dog profile found.</p>",
  "      )}",
  "      <section className=\"space-y-3\">",
  "        <div className=\"flex items-center justify-between\">",
  "          <h2 className=\"text-lg font-semibold text-foreground\">Vaccines</h2>",
  "          <button",
  "            onClick={() => { setShowForm(true); setEditingVaccine(null); }}",
  "            className=\"rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90\"",
  "          >",
  "            Add Vaccine",
  "          </button>",
  "        </div>",
  "        {vaccines.length === 0 ? (",
  "          <p className=\"text-sm text-muted\">No vaccine records yet.</p>",
  "        ) : (",
  "          <ul className=\"space-y-2\">",
  "            {vaccines.map((v) => (",
  "              <li key={v.id} className=\"flex flex-col gap-2\">",
  "                <VaccineRow vaccine={{ id: v.id, dog_id: v.dog_id, vaccine_name: v.vaccine_name, date_given: v.date_given, expiry_date: v.expiry_date, notes: v.notes }} />",
  "                <div className=\"flex gap-2 ml-1\">",
  "                  <button",
  "                    onClick={() => {",
  "                      setEditingVaccine({ id: v.id, vaccine_name: v.vaccine_name, date_given: v.date_given, expiry_date: v.expiry_date, notes: v.notes });",
  "                      setShowForm(true);",
  "                    }}",
  "                    className=\"rounded-md border border-border px-2 py-0.5 text-xs text-foreground hover:bg-muted\"",
  "                  >",
  "                    Edit",
  "                  </button>",
  "                  <button",
  "                    onClick={() => handleDelete(v.id)}",
  "                    className=\"rounded-md border border-destructive/30 px-2 py-0.5 text-xs text-destructive hover:bg-destructive/10\"",
  "                  >",
  "                    Delete",
  "                  </button>",
  "                </div>",
  "              </li>",
  "            ))}",
  "          </ul>",
  "        )}",
  "      </section>",
  "      {showForm && (",
  "        <div className=\"rounded-xl border border-border bg-card p-4 space-y-3\">",
  "          <h3 className=\"font-medium text-foreground\">{editingVaccine ? 'Edit Vaccine' : 'New Vaccine'}</h3>",
  "          <form",
  "            onSubmit={(e) => {",
  "              e.preventDefault();",
  "              const fd = new FormData(e.currentTarget);",
  "              const data = {",
  "                vaccine_name: String(fd.get('vaccine_name') ?? ''),",
  "                date_given: String(fd.get('date_given') ?? ''),",
  "                expiry_date: String(fd.get('expiry_date') ?? ''),",
  "                notes: String(fd.get('notes') ?? ''),",
  "              };",
  "              if (editingVaccine) { handleUpdate(data); } else { handleCreate(data); }",
  "            }}",
  "            className=\"space-y-3\"",
  "          >",
  "            <label className=\"block\">",
  "              <span className=\"text-sm text-foreground\">Vaccine Name</span>",
  "              <input name=\"vaccine_name\" defaultValue={editingVaccine?.vaccine_name ?? ''} required className=\"mt-1 block w-full rounded-md border border-border bg-background px-3 py-1.5 text-sm text-foreground\" />",
  "            </label>",
  "            <label className=\"block\">",
  "              <span className=\"text-sm text-foreground\">Date Given</span>",
  "              <input name=\"date_given\" type=\"date\" defaultValue={editingVaccine?.date_given ?? ''} className=\"mt-1 block w-full rounded-md border border-border bg-background px-3 py-1.5 text-sm text-foreground\" />",
  "            </label>",
  "            <label className=\"block\">",
  "              <span className=\"text-sm text-foreground\">Expiry Date</span>",
  "              <input name=\"expiry_date\" type=\"date\" defaultValue={editingVaccine?.expiry_date ?? ''} className=\"mt-1 block w-full rounded-md border border-border bg-background px-3 py-1.5 text-sm text-foreground\" />",
  "            </label>",
  "            <label className=\"block\">",
  "              <span className=\"text-sm text-foreground\">Notes</span>",
  "              <textarea name=\"notes\" defaultValue={editingVaccine?.notes ?? ''} className=\"mt-1 block w-full rounded-md border border-border bg-background px-3 py-1.5 text-sm text-foreground\" rows={2} />",
  "            </label>",
  "            <div className=\"flex gap-2\">",
  "              <button type=\"submit\" className=\"rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90\">",
  "                {editingVaccine ? 'Update' : 'Create'}",
  "              </button>",
  "              <button type=\"button\" onClick={() => { setShowForm(false); setEditingVaccine(null); }} className=\"rounded-md border border-border px-3 py-1.5 text-sm text-foreground\">",
  "                Cancel",
  "              </button>",
  "            </div>",
  "          </form>",
  "        </div>",
  "      )}",
  "    </main>",
  "  );",
  "}",
].join('\n'));
