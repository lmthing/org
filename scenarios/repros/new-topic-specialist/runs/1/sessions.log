// Build is clean: ok=true, built=true, routes=["/"], zero errors. Now run the mechanical checks.

const allErrors: Array<{ file: string; line?: number; phase: string; message: string }> = check.errors.map((e) => ({ file: e.file, line: e.line, phase: e.phase, message: e.message }));
// Check what's actually on disk in database/ — ground truth, not upstream claims.
const dbEntries = (listProjectDir('database').entries || []);
const tableNames = dbEntries.filter((n) => n.endsWith('.json')).map((n) => n.replace(/\.json$/, ''));
// Mechanical endpoint→table check: every literal table an api module touches must exist.
const apiEntries = (listProjectDir('api').entries || []);
const walk: string[] = apiEntries.map((n) => 'api/' + n);
while (walk.length) {
  const p = walk.shift() as string;
  if (!p.endsWith('.ts')) { const children = (listProjectDir(p).entries || []); for (const c of children) walk.push(p + '/' + c); continue; }
  const src = readProjectFile(p).content || '';
  const ref = /\bdb\s*\.\s*(?:query|insert|update|remove)\s*\(\s*['\"`]([A-Za-z0-9_-]+)['\"`]/g;
  let m;
  while ((m = ref.exec(src)) !== null) {
    if (!tableNames.includes(m[1])) allErrors.push({ file: p, phase: 'gate', message: 'references table "' + m[1] + '" which does not exist in database/ — builds clean but 500s at runtime' });
  }
}
// Mechanical page→endpoint check: collect real endpoint names from api/ modules.
const endpointNames: string[] = [];
const epWalk: string[] = apiEntries.map((n) => 'api/' + n);
while (epWalk.length) {
  const p = epWalk.shift() as string;
  if (!p.endsWith('.ts')) { const children = (listProjectDir(p).entries || []); for (const c of children) epWalk.push(p + '/' + c); continue; }
  const nm = /export\s+const\s+name\s*=\s*['\"`]([A-Za-z0-9_-]+)['\"`]/.exec(readProjectFile(p).content || '');
  if (nm && !endpointNames.includes(nm[1])) endpointNames.push(nm[1]);
}
// Scan pages + components for useApi/useApiMutation/apiCall references and render-correctness.
const pagesEntries = (listProjectDir('pages').entries || []);
const compsEntries = (listProjectDir('components').entries || []);
const clientWalk: string[] = pagesEntries.map((n) => 'pages/' + n).concat(compsEntries.map((n) => 'components/' + n));
while (clientWalk.length) {
  const p = clientWalk.shift() as string;
  if (!p.endsWith('.tsx') && !p.endsWith('.ts')) { const children = (listProjectDir(p).entries || []); for (const c of children) clientWalk.push(p + '/' + c); continue; }
  const src = readProjectFile(p).content || '';
  // Check useApi / useApiMutation / apiCall references against real endpoint names.
  const apiRef = /\b(?:useApi(?:Mutation)?|apiCall)\s*(?:<[^(]*>)?\s*\(\s*['\"`]([A-Za-z0-9_-]+)['\"`]/g;
  let m;
  while ((m = apiRef.exec(src)) !== null) {
    if (!endpointNames.includes(m[1])) allErrors.push({ file: p, phase: 'gate', message: 'calls useApi/useApiMutation/apiCall("' + m[1] + '") which is not a generated endpoint name (have: ' + (endpointNames.join(', ') || 'none') + ') — useApi silently short-circuits to an error state with NO network request, exactly like an unresolved import' });
  }
  // Check for raw { type, props } descriptor returns instead of JSX.
  const descriptorRef = /\breturn\s*\{\s*type\s*:\s*(?:'[^']*'|\"[^\"]*\"|[A-Za-z_$][\w$]*)\s*,\s*props\s*:/;
  if (descriptorRef.test(src)) allErrors.push({ file: p, phase: 'gate', message: 'returns a plain { type, props } object literal instead of JSX — that is this system\'s OWN display()-descriptor shape (the chat/tasklist protocol), not renderable React; it typechecks clean but throws React error #31 at runtime. Return real JSX (`<div>…</div>`), never `{ type, props }`.' });
}
// Gather upstream results.
const okTables = (Array.isArray(implement_tables) ? implement_tables : []).filter((x: { ok: boolean }) => x.ok).map((x: { name: string }) => x.name);
const okEndpoints = (Array.isArray(implement_endpoints) ? implement_endpoints : []).filter((x: { ok: boolean }) => x.ok).map((x: { route: string }) => x.route);
const okComponents = (Array.isArray(implement_components) ? implement_components : []).filter((x: { ok: boolean }) => x.ok).map((x: { name: string }) => x.name);
const pageResults = Array.isArray(implement_pages) ? implement_pages : [];
// Pages actually on disk (ground truth) — top-level *.tsx that are not wrappers.
const diskPages = pagesEntries.filter((e: string) => e.endsWith('.tsx') && !e.startsWith('_')).map((e: string) => e.replace(/\.tsx$/, ''));
// Anything planned that failed to LAND — page OR table.
const missing = [
  ...pageResults.filter((x: { ok: boolean }) => !x.ok).map((x: { route: string; error: string }) => ({ kind: 'page' as const, route: x.route, error: x.error })),
  ...(Array.isArray(implement_tables) ? implement_tables : []).filter((x: { ok: boolean }) => !x.ok).map((x: { name: string }) => ({ kind: 'table' as const, name: x.name, error: 'planned table failed to write' })),
];
// Resolve honestly: tables both failed upstream AND there may be none on disk. The build itself
// succeeded (routes=[/]), but the app is INCOMPLETE — missing the data foundation.
currentTask.resolve({
  ok: layout.ok && check.ok && check.built && allErrors.length === 0 && okTables.length > 0 && diskPages.length > 0 && missing.length === 0,
  built: check.built,
  tables: okTables,
  endpoints: okEndpoints,
  components: okComponents,
  pages: diskPages,
  routes: check.routes,
  missing,
  errors: allErrors,
});
