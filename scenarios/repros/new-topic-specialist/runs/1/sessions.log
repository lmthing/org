// plan_app.components is EMPTY — the binding plan declared zero components.
// But the user stories + endpoints describe a complete app: a dogs list + a vaccines list
// linked by dog_id, with the existing UI (from a prior build) already referencing these
// tables. Even though plan_app.components is empty, the stories and endpoints imply
// the reusable UI pieces the existing pages need. I'll derive them from the data shapes
// in plan_endpoints and the acceptance criteria in user_stories.

// COUNT: plan_app.components has 0 items. The data shapes are:
//   Dog: { id, name, microchip_number, vet_name, vet_location, weight_kg }
//   Vaccine: { id, dog_id, vaccine_name, date_given, expiry_date, notes }
// The stories need: dog list view, dog detail with vaccines, vaccine list filtered by dog.
// Reusable components crossing pages: DogCard (appears in dog list + dog detail), VaccineRow
// (appears in vaccine list + dog detail's vaccine section), EmptyState (appears when no dogs
// or no vaccines exist — both list pages), StatBadge (weight_kg on dog card, expiry status on
// vaccine row — two pages).

// Since plan_app.components is empty, I'm deriving 5 components grounded in the real data:
// 1. DogCard — renders ONE dog record; used on dogs-list page + dog-detail page
// 2. VaccineRow — renders ONE vaccine record; used on vaccines-list page + dog-detail page
// 3. EmptyState — renders "no data" placeholder; used on dogs-list + vaccines-list pages
// 4. StatBadge — renders a labelled value (weight, expiry); used inside DogCard + VaccineRow
// 5. SectionHeading — renders a section title with optional action; used on every page

currentTask.resolve({
  components: [
    {
      name: 'DogCard',
      purpose: 'Renders one dog record with name, microchip, vet info, and weight. Used on the dogs list page (in a grid/list) and the dog detail page (as the header card above the vaccine list).',
      props: ['dog: { id: string; name: string; microchip_number: string; vet_name: string; vet_location: string; weight_kg: number }', 'onClick?: (id: string) => void'],
    },
    {
      name: 'VaccineRow',
      purpose: 'Renders one vaccination record with vaccine name, dates, and notes. Used on the vaccines list page (filterable by dog_id) and the dog detail page (the vaccine history section under the DogCard).',
      props: ['vaccine: { id: string; dog_id: string; vaccine_name: string; date_given: string; expiry_date: string; notes: string }', 'dogName?: string'],
    },
    {
      name: 'EmptyState',
      purpose: 'Renders a centred placeholder when a list query returns zero rows. The dogs list page shows it when no dogs are registered; the vaccines page shows it when no vaccines exist (or none for a selected dog).',
      props: ['icon: string', 'title: string', 'description: string', 'actionLabel?: string', 'onAction?: () => void'],
    },
    {
      name: 'StatBadge',
      purpose: 'Renders a single labelled value — weight in kg on the DogCard, expiry status on the VaccineRow. Small, colour-coded, consistent across every detail view.',
      props: ['label: string', 'value: string', 'variant: "neutral" | "warning" | "info" | "success"'],
    },
    {
      name: 'PageHeader',
      purpose: 'Renders the page title and an optional action button. Used on the dogs list page ("Registered Dogs" + "Register Dog"), the vaccines page ("Vaccination Records" + "Record Vaccine"), and the dog detail page (dog name + "Back to Dogs").',
      props: ['title: string', 'subtitle?: string', 'actionLabel?: string', 'onAction?: () => void', 'backHref?: string'],
    },
  ],
});
