{
  "title": "Media",
  "description": "Standalone media records — the Stone Town photo and any future uploads. Serves the itinerary/Zanzibar section.",
  "columns": {
    "id": {
      "type": "string",
      "description": "Primary key",
      "primaryKey": true,
      "generated": "uuid"
    },
    "title": {
      "type": "string",
      "description": "Media title or caption"
    },
    "description": {
      "type": "string",
      "description": "Description of the media item"
    },
    "media_type": {
      "type": "string",
      "description": "Type: photo, video, document"
    },
    "url": {
      "type": "string",
      "description": "URL or path to the media file"
    },
    "associated_location": {
      "type": "string",
      "description": "Location this media is associated with (e.g. Stone Town)"
    },
    "associated_date_range": {
      "type": "string",
      "description": "Date range this media relates to, e.g. Aug 11–13"
    },
    "accommodation_name": {
      "type": "string",
      "description": "Associated accommodation, if any"
    },
    "uploaded_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of upload/association"
    }
  }
}
