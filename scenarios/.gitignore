# The generic runner (run-yaml.mjs) writes per-run evidence into <scenario>/.run/ — step-NN.json,
# step-NN.full.json, trace.md, summary.json, runner.pid. All ephemeral; the committed golden copies
# the lib tests assert against live in lib/__fixtures__/, which is NOT ignored.
*/.run/
.run-smoke/
.runs/
