{
  "name": "@lmthing/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "dev": "turbo run dev --parallel",
    "thing": "node scripts/thing-dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@lmthing/config": "workspace:*",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.1.0",
    "turbo": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
      }
    }
  }
}
